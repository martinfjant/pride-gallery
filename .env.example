# Environment variables for deploying to Azure via infra/deploy.sh.
# Copy to a private, untracked file (e.g. .env) and fill in real values,
# then `source` it before running the deploy — or just export them inline.
# NOTE: .env is gitignored; .env.example is committed as documentation.

# REQUIRED — the interim upload password. KEEP SECRET.
UPLOAD_PASSWORD=set-a-strong-password-here

# OPTIONAL — defaults shown; override only if needed.
LOCATION=swedencentral
RESOURCE_GROUP=martin-playground
BASE_NAME=pridegal
